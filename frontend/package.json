{
  "name": "athletiq-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "lint": "eslint --ext .js,.ts,.vue . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "cap:sync": "nuxt generate && npx cap sync",
    "cap:android": "nuxt generate && npx cap sync android && npx cap open android",
    "cap:ios": "nuxt generate && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/push-notifications": "^8.0.2",
    "@nuxt/icon": "^1.7.4",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/robots": "^5.7.1",
    "@nuxtjs/sitemap": "^7.6.0",
    "@pinia/nuxt": "^0.5.1",
    "chart.js": "^4.4.1",
    "nuxt": "^4.4.2",
    "pinia": "^2.1.7",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.29",
    "vue-chartjs": "^5.3.0",
    "@supabase/supabase-js": "^2.33.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.6.0",
    "typescript": "^5.3.3"
  }
}
